# Database
POSTGRES_USER=purrce
POSTGRES_PASSWORD=purrce
POSTGRES_DB=purrce

# Backend
DATABASE_URL=postgres://purrce:purrce@postgres:5432/purrce
RUST_LOG=purrce_backend=info,tower_http=info
API_PORT=8080
# Interface to bind. Keep 0.0.0.0 inside Docker (port mapping);
# use 127.0.0.1 for a bare-metal install so the API stays local.
BIND_ADDR=0.0.0.0
SCHEDULER_INTERVAL=30
DEFAULT_CURRENCY=CLP

# Scraper effort/resource profile: minimal | balanced | aggressive
#   minimal    -> local only: no proxy, 1 browser attempt (lowest resources)
#   balanced   -> honors HTTP_PROXY/HTTPS_PROXY, stealth retry (default)
#   aggressive -> every browser attempt uses stealth
PROFILE=balanced

# Obscura (headless browser)
OBSCURA_BIN=/usr/local/bin/obscura
OBSCURA_TIMEOUT=30
# Persistent browser profile (cookies/localStorage). Challenges solved by the
# browser (cf_clearance, etc.) are stored here and imported into the HTTP jar.
OBSCURA_STORAGE_DIR=/app/data/obscura
# Max browser processes running at once (memory guard).
OBSCURA_MAX_CONCURRENCY=3
# V8 heap cap passed to Obscura (global --v8-flags).
OBSCURA_V8_FLAGS=--max-old-space-size=256
# Cap a page's script-execution phase (ms) so a hung SPA cannot stall a worker.
OBSCURA_SCRIPT_DEADLINE_MS=20000

# Proxy (optional)
# HTTP_PROXY=http://proxy:8080
# HTTPS_PROXY=http://proxy:8080
# PROXY_URL=socks5://proxy:1080

# Frontend
API_URL=http://backend:8080
PORT=3000
HOST=0.0.0.0
